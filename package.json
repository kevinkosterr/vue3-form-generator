{
  "name": "@kevinkosterr/vue3-form-generator",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "author": "Kevin Koster (@kevinkoster)",
  "repository": "https://github.com/kevinkosterr/vue3-form-generator",
  "license": "MIT",
  "main": "./dist/vue3-form-generator.js",
  "scripts": {
    "dev": "vite",
    "dev:sass": "sass --watch src/scss/themes:apps/playground/css/",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "build": "vite build && sass src/scss/themes/:dist/themes/",
    "preview": "vite preview",
    "docs:dev": "vitepress dev apps/docs",
    "docs:build": "vitepress build apps/docs",
    "docs:preview": "vitepress preview apps/docs"
  },
  "exports": {
    ".": {
      "import": "./dist/vue3-form-generator.js",
      "types": "./dist/index.d.ts"
    },
    "./themes/*": "./dist/themes/*"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "keywords": [
    "vue-form-generator",
    "form generator",
    "form",
    "schema",
    "vue3-form-generator",
    "vue3 forms",
    "vuejs"
  ],
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "latest",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/ui": "^3.2.7",
    "@vue/language-core": "^3.3.13",
    "@vue/test-utils": "^2.5.1",
    "clipboard": "^2.0.11",
    "eslint": "^10.12.0",
    "eslint-plugin-import-alias": "^1.2.0",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^25.0.1",
    "sass": "^1.105.1",
    "terser": "^5.51.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-group-icons": "^1.7.7",
    "vitepress-plugin-tabs": "^0.9.1",
    "vitest": "^4.1.11",
    "vue": "^3.5.44",
    "vue-eslint-parser": "^10.4.1",
    "vue3-json-viewer": "^2.4.1"
  },
  "dependencies": {
    "@vueuse/core": "^14.4.0",
    "maska": "^3.2.0"
  }
}
